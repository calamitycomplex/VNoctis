datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Title {
  id                String        @id @default(uuid())
  name              String? // Display identity; initialized from scan extraction, not unique
  vndbId            String? // e.g. "v17"
  vndbTitle         String? // English title from VNDB
  vndbTitleOriginal String? // Japanese/original title
  synopsis          String? // Full synopsis
  developer         String? // Developer studio
  releaseDate       DateTime? // First release date
  lengthMinutes     Int? // Estimated play time
  vndbRating        Float? // Score 0-10
  coverPath         String? // Local path to cached cover (compatibility reference)
  tags              String        @default("[]") // JSON array of { id, name, spoiler }
  screenshots       String        @default("[]") // JSON array of screenshot URLs
  metadataSource    String        @default("unmatched") // auto|manual|unmatched
  metadataFetchedAt DateTime? // Last VNDB fetch time
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  archiveItems      ArchiveItem[]
  browserRuntime    BrowserRuntime?
  webRequests       WebRequest[]
}

model ArchiveItem {
  id              String   @id @default(uuid())
  titleId         String
  directoryPath   String   @unique
  directoryName   String
  sourceAvailable Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  title           Title    @relation(fields: [titleId], references: [id], onDelete: Restrict)
  game            Game?
  browserRuntimes BrowserRuntime[]

  @@index([titleId])
}

model Game {
  id                String         @id // Legacy directory-name fingerprint
  directoryPath     String         @unique // Absolute path in container
  directoryName     String // Raw directory name
  sourceAvailable   Boolean        @default(true) // Source discovered in the latest completed scan
  extractedTitle    String // Title from options.rpy or dir name
  vndbId            String? // e.g. "v17"
  steamAppId        String? // Steam application ID
  vndbTitle         String? // English title from VNDB
  vndbTitleOriginal String? // Japanese/original title
  synopsis          String? // Full synopsis
  developer         String? // Developer studio
  releaseDate       DateTime? // First release date
  lengthMinutes     Int? // Estimated play time
  vndbRating        Float? // Score 0-10
  coverPath         String? // Local path to cached cover
  tags              String         @default("[]") // JSON array of { id, name, spoiler }
  screenshots       String         @default("[]") // JSON array of screenshot URLs
  buildStatus       String         @default("not_built") // not_built|queued|building|built|failed|stale
  hidden            Boolean        @default(false) // User-hidden from library view
  publishStatus     String         @default("not_published") // not_published|publishing|published|failed (R2 mode only)
  publishedAt       DateTime? // Last successful publish time
  publishedVersion  String? // Hash of published build
  favorite          Boolean        @default(false) // DEPRECATED — kept for data migration; will be dropped in a follow-up migration
  buildJobId        String? // Most recent build job ID
  builtAt           DateTime? // Last successful build time
  webBuildPath      String? // URL to compiled web export
  metadataSource    String         @default("unmatched") // auto|manual|unmatched
  metadataFetchedAt DateTime? // Last VNDB fetch time
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  favoritedBy       UserFavorite[] // Per-user favorites (replaces global favorite)
  archiveItemId     String?        @unique
  archiveItem       ArchiveItem?   @relation(fields: [archiveItemId], references: [id], onDelete: Restrict)
}

model User {
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String // bcrypt hash (cost factor 12)
  role         String         @default("viewer") // "admin" | "viewer"
  // Per-app-user Kasm identity. Using one dedicated Kasm user per app user is
  // what makes the image volume template `{custom_attribute_1}` stable independent
  // of other app users; `custom_attribute_1` is that user's UUID set once.
  kasmUsername String?        @unique
  kasmUserId   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  favorites    UserFavorite[]
  webRequests  WebRequest[]
  browserSessions BrowserSession[]
}

model UserFavorite {
  userId    String
  gameId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
}

// ── Browser runtime workflow (state/workflow only; no Kasm/Docker yet) ──────
// One row per logical Title. Absence of the row means ARCHIVE_ONLY; the API
// still exposes ARCHIVE_ONLY explicitly. `archiveItemId` records the release a
// future curated golden runtime would be built from — never an implicit primary.
model BrowserRuntime {
  id            String       @id @default(uuid())
  titleId       String       @unique
  state         String       @default("REQUESTED") // REQUESTED|PREPARING|TESTING|READY|BROKEN|UNSUPPORTED
  archiveItemId String?
  note          String?
  manifestId    String? // Admin-owned runtime-manifest key under MANIFEST_ROOT
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  title         Title        @relation(fields: [titleId], references: [id], onDelete: Cascade)
  archiveItem   ArchiveItem? @relation(fields: [archiveItemId], references: [id], onDelete: SetNull)
  sessions      BrowserSession[]

  @@index([archiveItemId])
}

// User request for a Title's browser version. One active row per user/title.
model WebRequest {
  id        String   @id @default(uuid())
  titleId   String
  userId    String
  createdAt DateTime @default(now())
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([titleId, userId])
  @@index([titleId])
  @@index([userId])
}

// A single live/recent browser-play attempt for one user + prepared runtime.
//
// `activeKey` is set to "<userId>" while the session is active and cleared to
// NULL once it ends. This enforces AT MOST ONE active browser session per app
// user, which is required for correctness: a per-user Kasm identity carries a
// single mutable `custom_attribute_2` (runtime id) that Kasm re-expands while a
// kasm is still ASSIGNED/REQUESTED, so it must not change during an active
// session. SQLite treats NULLs as distinct, so any number of ended rows coexist
// and different users (separate Kasm identities) run concurrently.
model BrowserSession {
  id               String         @id @default(uuid())
  browserRuntimeId String
  userId           String
  kasmSessionId    String?        @unique
  state            String         @default("STARTING") // STARTING|RUNNING|STOPPING|ENDED|ERROR
  activeKey        String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  lastSeenAt       DateTime       @default(now())
  endedAt          DateTime?
  browserRuntime   BrowserRuntime @relation(fields: [browserRuntimeId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([browserRuntimeId])
  @@index([userId])
  @@index([state])
}

model BuildJob {
  id          String    @id @default(uuid())
  gameId      String
  status      String    @default("queued") // queued|building|done|failed|cancelled
  logPath     String? // Path to build log file
  startedAt   DateTime?
  completedAt DateTime?
  error       String? // Error message if failed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ScanJob {
  id               String    @id @default(uuid())
  status           String    @default("running") // running|completed|failed
  gamesFound       Int       @default(0)
  gamesNew         Int       @default(0)
  gamesRemoved     Int       @default(0)
  gamesUnavailable Int       @default(0)
  error            String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
}

// ── R2 Publish models (only present in vnm-r2.db) ────────
// Applied via raw SQL in R2 mode; never via a Prisma migration so that
// vnm.db (the non-R2 database) remains clean.

model Setting {
  key       String   @id
  value     String // AES-256-GCM encrypted for secrets
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublishJob {
  id            String    @id @default(uuid())
  gameId        String
  status        String    @default("queued") // queued|uploading|done|failed|cancelled
  progress      Int       @default(0) // 0-100 percentage
  filesTotal    Int       @default(0)
  filesUploaded Int       @default(0)
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
